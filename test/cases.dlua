-- test/cases.dlua -- the test body. `M` is defined by test/run.sh, which
-- wraps accounts.dlua in an IIFE and concatenates this file after it.
--
-- The doubles below stand in for the five libraries accounts-lib depends on
-- and for the connector. They are deliberately dumb: every assertion here is
-- about THIS module's arithmetic, branch order, refusal codes and
-- absence-vs-nil discipline, never about a sibling's.

local fails = 0
local function ok(c, m) if c then print("   ok   " .. m) else print("   FAIL " .. m); fails = fails + 1 end end

-- ------------------------------------------------------------ the doubles

-- discofetch-model-lib's codec, as the real one behaves: hex in, base32 out.
local B32 = 'abcdefghijklmnopqrstuvwxyz234567'
local function base32_from_hex(hex)
  local out, acc, nbits = {}, 0, 0
  for i = 1, #hex, 2 do
    acc = (acc << 8) | tonumber(hex:sub(i, i + 1), 16)
    nbits = nbits + 8
    while nbits >= 5 do
      nbits = nbits - 5
      out[#out + 1] = B32:sub(((acc >> nbits) & 31) + 1, ((acc >> nbits) & 31) + 1)
    end
    acc = acc & ((1 << nbits) - 1)
  end
  return table.concat(out)
end

-- drt-db-lib's rows_by_name.
local function rows_by_name(q)
  local out = {}
  for _, row in ipairs(q.rows) do
    local m = {}
    for i, name in ipairs(q.cols) do m[name] = row[i] end
    out[#out + 1] = m
  end
  return out
end

-- drt-http-api-lib's int_param.
local function int_param(v)
  local n = tonumber(v)
  if not n or n ~= math.floor(n) then return nil end
  return math.floor(n)
end

-- The connector. Routes are matched as plain substrings, first one wins, so
-- register the specific statement before the general table name.
local function mkdb()
  local db = { log = {}, routes = {},
               exec_result = { changes = 1, rowid = 7 },
               try_result  = { changes = 1, rowid = 7 } }
  function db.on(pat, fn) db.routes[#db.routes + 1] = { pat = pat, fn = fn } end
  db.query = function(sql, ...)
    local binds = table.pack(...)
    db.log[#db.log + 1] = { kind = 'query', sql = sql, binds = binds }
    for _, r in ipairs(db.routes) do
      if sql:find(r.pat, 1, true) then
        return r.fn(table.unpack(binds, 1, binds.n)) or { cols = {}, rows = {} }
      end
    end
    return { cols = {}, rows = {} }
  end
  db.exec = function(sql, ...)
    db.log[#db.log + 1] = { kind = 'exec', sql = sql, binds = table.pack(...) }
    return db.exec_result
  end
  db.try_exec = function(sql, ...)
    db.log[#db.log + 1] = { kind = 'try_exec', sql = sql, binds = table.pack(...) }
    if type(db.try_result) == 'function' then return db.try_result() end
    return db.try_result
  end
  return db
end

local function last(db, kind, pat)
  for i = #db.log, 1, -1 do
    local e = db.log[i]
    if (kind == nil or e.kind == kind) and (pat == nil or e.sql:find(pat, 1, true)) then
      return e
    end
  end
end

local function count(db, kind, pat)
  local n = 0
  for _, e in ipairs(db.log) do
    if (kind == nil or e.kind == kind) and (pat == nil or e.sql:find(pat, 1, true)) then n = n + 1 end
  end
  return n
end

local function res(cols, rows) return { cols = cols, rows = rows } end

-- node-event-lib.
local function mkevents()
  local ev = { rows = {}, at = nil }
  function ev:log(kind, subject_id, actor, f)
    self.rows[#self.rows + 1] = { kind = kind, subject = subject_id,
                                  actor = M.resolve_actor(actor), f = f or {} }
  end
  function ev:last(kind, subject_id, actor_id)
    self.want = { kind, subject_id, actor_id }
    return self.at
  end
  function ev:kinds()
    local k = {}
    for i, r in ipairs(self.rows) do k[i] = r.kind end
    return table.concat(k, ',')
  end
  return ev
end

local TOKEN = 'Bearer dfp_live_abcd2345'

-- The same account row, reached the other way in: resolve_account decides
-- `via` itself, so a test about WHICH CREDENTIAL has to arrive with one.
local function as_token(db, role, tier)
  table.insert(db.routes, 1, { pat = 'FROM api_token k', fn = function()
    return { cols = {}, rows = { { 4, 'google|1', 'a@b.co', tier or 'free',
                                   role or 'user', 1, 2, 77, 10 ^ 9 } } }
  end })
  return db
end

-- token-rate-limit-lib. POLICIES lands on the instance the way it would
-- through the library's own __index, and the policy tables are spelled
-- per_hour/burst because that is what the real one asserts on.
--
-- check() RETURNS THE REFUSAL AS ONE TABLE -- true on allow, `false, refusal`
-- on deny, where refusal carries status/code/message/body/headers/wait. This
-- double returned a status/body/headers triple once, which is not the shape
-- the library has, and the arity mismatch it hid is exactly what a double
-- that agrees with its consumer instead of with its subject costs.
local function mkrate()
  local rl = { POLICIES = { redeem  = { per_hour = 30, burst = 10 },
                            authfail = { per_hour = 30, burst = 10 } }, calls = {} }
  function rl:check(key, policy, what)
    self.calls[#self.calls + 1] = { key = key, policy = policy, what = what }
    if self.deny then
      local message = what .. '; retry in 7s'
      return false, {
        status  = 429,
        code    = 'rate_limited',
        message = message,
        body    = { error = { code = 'rate_limited', message = message } },
        headers = { ['retry-after'] = '7', ['cache-control'] = 'no-store' },
        wait    = 7,
      }
    end
    return true
  end
  return rl
end

local draws = 0
local function mkdeps(db, t)
  local ev, rl = mkevents(), mkrate()
  return {
    db = db, json = json,
    now = function() return t or 1000 end,
    ready = function() return true end,
    crypto = {
      random = function(n)
        draws = draws + 1
        return string.rep(string.format('%02x', draws % 256), n)
      end,
      hash = function(s) return 'H:' .. s end,
    },
    drtdb = { rows_by_name = rows_by_name },
    model = { base32_from_hex = base32_from_hex },
    http  = { int_param = int_param },
    events = ev, rate = rl,
  }
end

local function inst(db, t)
  local d = mkdeps(db, t)
  return M.new(d), d
end

local function code_of(payload)
  return type(payload) == 'table' and payload.error and payload.error.code or nil
end

-- ========================================================== the pure half

-- the token grammar
ok(M.opaque_token('Bearer dfp_live_abcd2345') == 'dfp_live_abcd2345', 'opaque_token takes a well-formed bearer')
ok(M.opaque_token('bearer dfp_live_abcd2345') == 'dfp_live_abcd2345', 'opaque_token accepts a lowercase bearer')
ok(M.opaque_token('Bearer eyJhbGciOi.J9.x') == nil, 'a JWT that reached us is not a token and is never hashed')
ok(M.opaque_token('Bearer dfp_live_ABCD2345') == nil, 'the alphabet is the alphabet: uppercase is not a token')
ok(M.opaque_token('Bearer dfp_live_abc-1') == nil, 'a truncated or punctuated paste is not a token')
ok(M.opaque_token('dfp_live_abcd2345') == nil, 'without Bearer it is not a token')
ok(M.opaque_token(nil) == nil and M.opaque_token(42) == nil, 'a non-string header is not a token')
ok(M.TOKEN_PREFIX == 'dfp_live_' and M.TOKEN_BYTES == 20, 'the prefix and the 160-bit draw are what the gateway and a repo scanner match on')

-- the registries degrade
ok(M.tier_of('nope').title == 'Free', "a typo'd tier degrades to free rather than erroring")
ok(M.tier_of(nil).title == 'Free', 'a missing tier degrades to free')
ok(M.tier_of('plus') == M.TIERS.homelab, 'plus is Homelab: a rename must not silently demote a paying account')
ok(M.tier_of('free').fetchpoints == 3 and M.tier_of('homelab').fetchpoints == 25
   and M.tier_of('platform').fetchpoints == 2000 and M.tier_of('system').fetchpoints == 1000,
   'the four fetchpoint caps are the published ones')
ok(M.tier_of('free').tokens == 1 and M.tier_of('free').invites == 2,
   'free gets one token and two invites, on purpose')
ok(M.role_rank('admin') == 2 and M.role_rank('audit') == 1 and M.role_rank('user') == 0,
   'the rank ladder is ordered')
ok(M.role_rank('root') == 0 and M.role_rank(nil) == 0, 'an unknown role ranks zero, never admin')

-- the two guards
ok(M.require_session({ via = 'session' }) == true, 'a session may mint')
do
  local okay, s, p = M.require_session({ via = 'token' })
  ok(okay == false and s == 403 and code_of(p) == 'session_required', 'a token may not mint or revoke')
  ok(p.error.message == M.SESSION_MINT, 'the default sentence is the minting rule')
  local _, _, p2 = M.require_session({ via = 'token' }, 'because bananas')
  ok(p2.error.message == 'because bananas', 'why is passed through, so a refusal explains the rule that fired')
end
ok(M.require_own_account({}) == true, 'not impersonating: everything is allowed')
do
  local okay, s, p = M.require_own_account({ impersonating = true }, M.GRANT_ACT_AS)
  ok(okay == false and s == 403 and code_of(p) == 'act_as_forbidden', 'a window may not do what outlives it')
  ok(p.error.message:find('outlives', 1, true) ~= nil, 'the sentence says why: it outlives the window')
end

-- the actor unwrap that node-event-lib takes as resolve_actor
do
  local admin = { id = 9, role = 'admin' }
  local wearing = { id = 3, role = 'user', acted_by = admin }
  ok(M.resolve_actor(wearing) == admin, 'resolve_actor finds the real caller under the face')
  ok(M.resolve_actor({ id = 3 }).id == 3, 'without a window the actor is the account itself')
  ok(M.resolve_actor(nil) == nil, 'no actor is nil, not an error')
end

-- when a gift counts / when a code counts
do
  local s = M.grant_live_sql(1234)
  ok(s:find('redeemed_at IS NOT NULL', 1, true) and s:find('revoked_at IS NULL', 1, true)
     and s:find('expires_at > 1234', 1, true),
     'grant_live_sql spells all three clauses and interpolates the computed t')
  local i = M.invite_live_sql(77)
  ok(i:find('revoked_at IS NULL', 1, true) and i:find('expires_at > 77', 1, true)
     and i:find('used_count < max_uses', 1, true),
     'invite_live_sql spells not-revoked, not-expired and uses-left')
end

-- validate_grant: the write-time door that says what quota_of will only degrade
do
  local t = 1000
  ok(select(2, M.validate_grant('nope', t)).error.code == 'invalid_grant', 'a grant must be an object')
  ok(select(2, M.validate_grant({ kind = 'gift' }, t)).error.code == 'invalid_kind', 'the kind comes off the registry')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = 1.5 }, t)).error.code == 'invalid_quantity',
     'a fractional quantity is not a quantity')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = -1 }, t)).error.code == 'invalid_quantity',
     'a negative quantity is refused')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = M.GRANT_QUANTITY_MAX + 1 }, t)).error.code
     == 'invalid_quantity', 'a bonus larger than the cap is a typo')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus' }, t)).error.code == 'invalid_quantity',
     'a quota_bonus of zero grants nothing and is refused at the door')
  ok(select(2, M.validate_grant({ kind = 'name_credit' }, t)).error.code == 'invalid_quantity',
     'a name_credit of zero grants nothing and is refused at the door')
  local g = M.validate_grant({ kind = 'tier_grant', detail = { tier = 'homelab' }, expires_at = t + 60 }, t)
  ok(g and g.quantity == 0, 'a tier_grant of no quantity is legal: it is not a countable kind')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = 1, detail = 'x' }, t)).error.code
     == 'invalid_detail', 'detail must be an object')
  local b = M.validate_grant({ kind = 'quota_bonus', quantity = 5 }, t)
  ok(b.detail.resource == 'fetchpoints', 'fetchpoints is what a bonus means when it does not say')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = 5, detail = { resource = 'fetchpoint' } }, t))
     .error.code == 'invalid_resource', "a typo'd resource is a 400 here, because read time can only degrade")
  ok(select(2, M.validate_grant({ kind = 'tier_grant', detail = { tier = 'homelap' }, expires_at = t + 1 }, t))
     .error.code == 'invalid_grant_tier', "a typo'd tier is a 400 here for the same reason")
  ok(select(2, M.validate_grant({ kind = 'tier_grant', detail = { tier = 'homelab' } }, t)).error.code
     == 'expiry_required', 'a tier_grant always expires, and visibly')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = 1, expires_at = t }, t)).error.code
     == 'invalid_expiry', 'an expiry must be in the future')
  ok(select(2, M.validate_grant({ kind = 'quota_bonus', quantity = 1, expires_at = t + 0.5 }, t)).error.code
     == 'invalid_expiry', 'an expiry must be whole seconds')
  local p = M.validate_grant({ kind = 'quota_bonus', quantity = 1, source = 'paid' }, t)
  ok(p.source == nil, 'source is provenance: each door knows it and the grant itself does not')
end

-- validate_invite_fields: one opinion for both mint doors
do
  local t = 1000
  local f = M.validate_invite_fields({}, t)
  ok(f.note == '' and f.max_uses == 1 and f.expires_at == nil, 'the defaults are one use, no note, no expiry')
  ok(select(2, M.validate_invite_fields({ note = string.rep('x', M.NOTE_MAX + 1) }, t)).error.code
     == 'invalid_note', 'a note is bounded')
  ok(select(2, M.validate_invite_fields({ max_uses = 0 }, t)).error.code == 'invalid_max_uses',
     'a code with no uses is not a code')
  ok(select(2, M.validate_invite_fields({ max_uses = M.INVITE_MAX_USES + 1 }, t)).error.code
     == 'invalid_max_uses', 'max_uses is capped at the registry number')
  ok(select(2, M.validate_invite_fields({ expires_at = t - 1 }, t)).error.code == 'invalid_expiry',
     'an invite expiry must be in the future')
end

ok(M.invite_prefix('dfi_abcdefghijklmnop') == 'dfi_abcd', 'the prefix is dfi_ plus four symbols and nothing more')
ok(#M.invite_prefix('dfi_abcdefghijklmnop') == 8, 'twenty bits: enough to say which, nothing to extend')
ok(M.INVITE_INVALID.error.code == 'invalid_code', 'one answer for four refusals')

do
  local r = M.token_row({ id = 1, name = 'ci', prefix = 'dfp_live_abcd', hash = 'H:secret',
                          created_at = 5, last_used_at = 6, expires_at = nil })
  ok(r.hash == nil, 'a token row never carries the hash, under any circumstance')
  ok(r.prefix == 'dfp_live_abcd' and r.expires_at == nil, 'it carries the prefix, and absence stays absence')
end

-- ================================================ the constructor refuses

do
  local d = mkdeps(mkdb())
  local function without(k)
    local c = {}
    for kk, vv in pairs(d) do c[kk] = vv end
    c[k] = nil
    return c
  end
  local okc, err = pcall(M.new, without('db'))
  ok(not okc and tostring(err):find('deps.db', 1, true) ~= nil, 'a missing db is a named failure at new')
  okc, err = pcall(M.new, without('now'))
  ok(not okc and tostring(err):find('deps.now', 1, true) ~= nil, 'a missing clock is a named failure at new')
  local c = without('now'); c.now = 1000
  okc, err = pcall(M.new, c)
  ok(not okc and tostring(err):find('SECONDS', 1, true) ~= nil,
     'a wrong-typed clock is named at new, and the sentence says the unit')
  okc, err = pcall(M.new, without('ready'))
  ok(not okc and tostring(err):find('predicate', 1, true) ~= nil,
     'ready must be a predicate, because the flag flips after migrate')
  okc, err = pcall(M.new, without('events'))
  ok(not okc and tostring(err):find('node-event-lib', 1, true) ~= nil, 'the event log is named at new')
  okc, err = pcall(M.new, without('model'))
  ok(not okc and tostring(err):find('base32_from_hex', 1, true) ~= nil,
     'the model dep is REQUIRED and the assert says what it is for')
  local c2 = without('rate'); c2.rate = { check = function() end }
  okc, err = pcall(M.new, c2)
  ok(not okc and tostring(err):find('POLICIES.redeem', 1, true) ~= nil,
     'a limiter without the policy table is refused: one dep, not a raw bucket')
  ok(pcall(M.new, d), 'a complete deps table constructs')
end

-- two instances coexist
do
  local d1, d2 = mkdb(), mkdb()
  d1.on('FROM fetchpoint', function() return res({ 'c' }, { { 1 } }) end)
  d2.on('FROM fetchpoint', function() return res({ 'c' }, { { 2 } }) end)
  d1.on('FROM api_token', function() return res({ 'c' }, { { 0 } }) end)
  d2.on('FROM api_token', function() return res({ 'c' }, { { 0 } }) end)
  local a1 = inst(d1, 100)
  local a2 = inst(d2, 200)
  local q1 = a1:quota_of({ id = 1, tier = 'free' })
  local q2 = a2:quota_of({ id = 1, tier = 'homelab' })
  ok(q1.fetchpoints.used == 1 and q2.fetchpoints.used == 2, 'two instances read their own db')
  ok(q1.tier == 'free' and q2.tier == 'homelab', 'two instances hold no shared state')
end

-- ================================================== quota_of, the three rules

local function quotadb(grants, used, tokens)
  local db = mkdb()
  db.on('FROM fetchpoint', function() return res({ 'c' }, { { used or 0 } }) end)
  db.on('FROM api_token', function() return res({ 'c' }, { { tokens or 0 } }) end)
  db.on('SELECT kind, quantity, detail', function() return res({ 'kind', 'quantity', 'detail' }, grants or {}) end)
  return db
end

do
  local a = inst(quotadb({}, 1, 0))
  local q = a:quota_of({ id = 1, tier = 'free' })
  ok(q.tier == 'free' and q.tier_source == 'account' and q.plan == 'Free', 'the base tier is the account column')
  ok(q.fetchpoints.base == 3 and q.fetchpoints.bonus == 0 and q.fetchpoints.limit == 3,
     'base and bonus travel beside the limit so a dispute has both halves')
  ok(q.fetchpoints.used == 1 and q.tokens.used == 0, 'used counts live rows only')
  ok(q.dns_updates_per_hour == 120 and q.room_joins_per_minute == 120, 'the rate numbers come off the tier')
end

do -- quota_bonus is ADDITIVE
  local a = inst(quotadb({
    { 'quota_bonus', 5, json.encode({ resource = 'fetchpoints' }) },
    { 'quota_bonus', 2, json.encode({}) },
    { 'quota_bonus', 3, json.encode({ resource = 'tokens' }) },
  }, 0, 0))
  local q = a:quota_of({ id = 1, tier = 'free' })
  ok(q.fetchpoints.bonus == 7 and q.fetchpoints.limit == 10,
     'quota_bonus layers additively, and an unnamed resource means fetchpoints')
  ok(q.tokens.bonus == 3 and q.tokens.limit == 4, 'the token cap layers the same way')
end

do -- a typo adds to nothing
  local a = inst(quotadb({
    { 'quota_bonus', 9, json.encode({ resource = 'fetchpoint' }) },
    { 'quota_bonus', 9, json.encode({ resource = 'rooms' }) },
    { 'quota_bonus', 0, json.encode({}) },
    { 'quota_bonus', -4, json.encode({}) },
    { 'quota_bonus', 4, 'not json at all' },
  }, 0, 0))
  local q = a:quota_of({ id = 1, tier = 'free' })
  ok(q.fetchpoints.bonus == 4 and q.fetchpoints.limit == 7,
     'an unrecognised resource adds to nothing, never to the wrong thing; undecodable detail is empty, so it defaults')
  ok(q.tokens.bonus == 0, 'nothing leaked onto the other cap')
end

do -- tier_grant is LAST-WINS OVERRIDE, and reports provenance
  local a = inst(quotadb({
    { 'tier_grant', 0, json.encode({ tier = 'platform' }) },
    { 'tier_grant', 0, json.encode({ tier = 'homelab' }) },
  }, 0, 0))
  local q = a:quota_of({ id = 1, tier = 'free' })
  ok(q.tier == 'homelab' and q.plan == 'Homelab', 'the last live tier_grant wins')
  ok(q.tier_source == 'grant', "tier_source says which column it came from, or the account page reads as a bug")
  ok(q.fetchpoints.base == 25, 'the caps are computed from the effective tier')
end

do -- an unknown granted tier is ignored; an unknown account tier falls back
  local a = inst(quotadb({ { 'tier_grant', 0, json.encode({ tier = 'gold' }) } }, 0, 0))
  local q = a:quota_of({ id = 1, tier = 'homelab' })
  ok(q.tier == 'homelab' and q.tier_source == 'account',
     "a typo'd granted tier degrades to the account's own, never takes the account out")
  local b = inst(quotadb({}, 0, 0))
  local q2 = b:quota_of({ id = 1, tier = 'enterprise' })
  ok(q2.tier == 'free' and q2.plan == 'Free' and q2.tier_source == 'account',
     'an unknown account tier falls back to free rather than erroring')
  local c = inst(quotadb({}, 0, 0))
  ok(c:quota_of({ id = 1, tier = 'plus' }).fetchpoints.base == 25,
     'a row still carrying plus gets Homelab, through quota_of too')
end

do -- the grant read is bounded and live-only
  local db = quotadb({}, 0, 0)
  local a = inst(db, 4242)
  a:quota_of({ id = 7, tier = 'free' })
  local e = last(db, 'query', 'SELECT kind, quantity, detail')
  ok(e.sql:find('LIMIT ' .. M.QUOTA_GRANT_ROWS, 1, true) ~= nil,
     'the quota read is LIMITed: the connector refuses past its row cap rather than truncating')
  ok(e.sql:find('redeemed_at IS NOT NULL', 1, true) ~= nil and e.sql:find('expires_at > 4242', 1, true) ~= nil,
     'it counts live grants through the one fragment, with the clock this instance was handed')
end

-- ============================================== resolving, and the 503 flip

do
  local db = mkdb()
  local d = mkdeps(db)
  local ready = false
  d.ready = function() return ready, 'unable to open database file' end
  local a = M.new(d)
  local acct, s, p = a:resolve_account({ sub = 'google|1' })
  ok(acct == nil and s == 503 and code_of(p) == 'db_unavailable', 'a shut database is an honest 503')
  ok(p.error.message == 'unable to open database file', "the connector's own sentence is the message")
  ready = true
  db.on('FROM account WHERE auth0_sub', function() return res({ 'id' }, {}) end)
  local _, s2, p2 = a:resolve_account({ sub = 'google|1' })
  ok(s2 == 403 and code_of(p2) == 'registration_closed',
     'ready is a PREDICATE: the same instance answers correctly once migrate has run')
end

do
  local a = inst(mkdb())
  local _, s, p = a:resolve_account({})
  ok(s == 401 and code_of(p) == 'unauthenticated', 'no assertion and no token is 401, and creates no row')
end

do
  local db = mkdb()
  db.on('FROM account WHERE auth0_sub', function()
    return res({ 'id', 'auth0_sub', 'email', 'tier', 'role', 'created_at', 'last_seen_at', 'suspended_at' },
               { { 4, 'google|1', 'a@b.co', 'free', 'user', 1, 2, 9000 } })
  end)
  local a = inst(db)
  local acct, s, p = a:resolve_account({ sub = 'google|1' })
  ok(acct == nil and s == 403 and code_of(p) == 'account_suspended',
     'suspension closes the control plane, and a session is told so honestly')
  ok(p.error.message:find('your names keep serving', 1, true) ~= nil,
     'and told that their FetchPoints keep serving, because that is the decision')
  local e = last(db, 'exec', 'UPDATE account SET last_seen_at')
  ok(e ~= nil and e.sql:find('?2 - 300', 1, true) ~= nil,
     'last_seen_at is written coarsely, five-minute resolution, so a read is not a write')
end

do
  local db = mkdb()
  db.on('FROM account WHERE auth0_sub', function()
    return res({ 'id', 'auth0_sub', 'tier', 'role', 'suspended_at' },
               { { 4, 'google|1', 'free', 'user', nil } })
  end)
  local a = inst(db)
  local req = { sub = 'google|1' }
  local acct = a:resolve_account(req)
  ok(acct and acct.id == 4 and acct.tier == 'free', 'the row is mapped BY NAME, never positionally')
  ok(req.via == 'session', 'the credential that arrived is recorded for the two guards that need it')
end

-- the token door
do
  local db = mkdb()
  local seen
  db.on('FROM api_token k', function(hash, t)
    seen = hash
    return res({}, {})
  end)
  local a = inst(db)
  local row, s, p = a:account_by_token('dfp_live_abcd2345')
  ok(seen == 'H:dfp_live_abcd2345', 'the stored hash is what is looked up, never the secret')
  ok(row == nil and s == 401 and code_of(p) == 'unauthenticated', 'a token that does not resolve is 401')
  ok(p.error.message == 'that token is not valid',
     'revoked, expired, never existed and deleted all answer the SAME sentence')
end

do
  local function tokendb(last_used)
    local db = mkdb()
    db.on('FROM api_token k', function()
      return res({}, { { 4, 'google|1', 'a@b.co', 'free', 'user', 1, 2, 77, last_used } })
    end)
    return db
  end
  local db = tokendb(nil)
  local a = inst(db, 5000)
  local row = a:account_by_token('dfp_live_abcd2345')
  ok(row.id == 4 and row.role == 'user', 'a token resolves to the same account row a session gets')
  ok(last(db, 'exec', 'UPDATE api_token SET last_used_at') ~= nil, 'a never-used token gets its stamp')
  local db2 = tokendb(4900)
  local a2 = inst(db2, 5000)
  a2:account_by_token('dfp_live_abcd2345')
  ok(last(db2, 'exec', 'UPDATE api_token SET last_used_at') == nil,
     'inside five minutes the read path stays a read')
  local db3 = tokendb(4600)
  local a3 = inst(db3, 5000)
  a3:account_by_token('dfp_live_abcd2345')
  ok(last(db3, 'exec', 'UPDATE api_token SET last_used_at') ~= nil, 'past five minutes it writes once')
end

-- ========================================== act-as: the refusals, in order

local function target_row(over)
  local r = { id = 3, auth0_sub = 'google|3', email = 'c@d.co', tier = 'free',
              role = 'user', created_at = 1, last_seen_at = 2, suspended_at = nil }
  for k, v in pairs(over or {}) do r[k] = v end
  return r
end

local function actasdb(target)
  local db = mkdb()
  db.on('FROM account WHERE id', function()
    if not target then return res({ 'id' }, {}) end
    local cols, row = {}, {}
    for _, k in ipairs({ 'id', 'auth0_sub', 'email', 'tier', 'role', 'created_at', 'last_seen_at', 'suspended_at' }) do
      cols[#cols + 1] = k
      row[#row + 1] = target[k]
    end
    return res(cols, { row })
  end)
  return db
end

do
  local a, d = inst(actasdb(target_row()))
  local admin = { id = 9, role = 'admin', auth0_sub = 'google|9' }
  ok(a:act_as_apply({ act_as = nil, via = 'session' }, admin) == admin,
     'the ordinary path is indistinguishable from a program that never heard of this')
  ok(a:act_as_apply({ act_as = '', via = 'session' }, admin) == admin, 'an empty header is the ordinary path')
  ok(#d.events.rows == 0, 'and it writes nothing')

  local _, s, p = a:act_as_apply({ act_as = '3', via = 'token' }, admin)
  ok(s == 403 and code_of(p) == 'act_as_session_required', 'a token may never impersonate')

  local _, s2, p2 = a:act_as_apply({ act_as = '3', via = 'session' }, { id = 8, role = 'audit' })
  ok(s2 == 403 and code_of(p2) == 'admin_required', 'audit is a read role and impersonation is a write')

  local _, s3, p3 = a:act_as_apply({ act_as = '3', via = 'session', path = '/v1/admin/accounts' }, admin)
  ok(s3 == 403 and code_of(p3) == 'act_as_not_here', 'never on /v1/admin: which identity ran the mutation')
  local _, s3b, p3b = a:act_as_apply({ act_as = '3', via = 'session', path = '/v1/adminfoo' }, admin)
  ok(s3b == 403 and code_of(p3b) == 'act_as_not_here', 'matched without the trailing slash, so a bare route is covered')

  local _, s4, p4 = a:act_as_apply({ act_as = '3', via = 'session', path = '/v1/admin' },
                                   { id = 8, role = 'user' })
  ok(code_of(p4) == 'admin_required',
     'the branch ORDER holds: the rank is checked before the route')
end

do
  local a = inst(actasdb(nil))
  local admin = { id = 9, role = 'admin' }
  for _, want in ipairs({ 'nope', '0', '-2', '1.5', '' }) do
    if want ~= '' then
      local _, s, p = a:act_as_apply({ act_as = want, via = 'session' }, admin)
      ok(s == 404 and code_of(p) == 'no_such_account',
         'act-as ' .. want .. ' names no account and lands on the honest 404')
    end
  end
end

do
  local admin = { id = 9, role = 'admin' }
  local a1 = inst(actasdb(target_row({ auth0_sub = 'system|root' })))
  local _, s, p = a1:act_as_apply({ act_as = '3', via = 'session' }, admin)
  ok(s == 403 and code_of(p) == 'no_impersonating_system',
     'never as a system account: it owns the canary and no IdP can sign in as it')
  local a2 = inst(actasdb(target_row({ auth0_sub = 'system|second' })))
  ok(code_of(select(3, a2:act_as_apply({ act_as = '3', via = 'session' }, admin))) == 'no_impersonating_system',
     'matched on the SCOPE PREFIX, so a second system account is covered the day it exists')
  local a3 = inst(actasdb(target_row({ suspended_at = 99 })))
  ok(code_of(select(3, a3:act_as_apply({ act_as = '3', via = 'session' }, admin))) == 'account_suspended',
     'never into an identity the system itself refuses')
  local a4 = inst(actasdb(target_row({ role = 'admin' })))
  ok(code_of(select(3, a4:act_as_apply({ act_as = '3', via = 'session' }, admin))) == 'no_impersonating_admins',
     'never as an admin: no laundering, and acting as yourself is impossible')
end

do
  local a, d = inst(actasdb(target_row()), 10000)
  local admin = { id = 9, role = 'admin', auth0_sub = 'google|9' }
  local req = { act_as = '3', via = 'session', real_ip = '1.2.3.4' }
  local target = a:act_as_apply(req, admin)
  ok(target.id == 3, 'the request runs as the target')
  ok(req.impersonating == true and req.actor == admin, 'the request carries the confession for the guards and /v1/me')
  ok(target.acted_by == admin, 'and the ROW carries it for the event log, which reads acted_by and nothing else')
  ok(d.events.rows[1] and d.events.rows[1].kind == 'impersonate.start', 'staff looking is recorded')
  ok(d.events.rows[1].actor == admin, 'the actor is the real caller, not the customer')
  ok(d.events.rows[1].f.address == '1.2.3.4', "and the operator's address rides along")
  ok(d.events.want[1] == 'impersonate.start' and d.events.want[2] == 3 and d.events.want[3] == 9,
     'the recency read is asked for by kind, subject and actor')
end

do -- one row per window, not one per request
  local a, d = inst(actasdb(target_row()), 10000)
  d.events.at = 10000 - M.ACT_AS_EVENT_EVERY + 1
  a:act_as_apply({ act_as = '3', via = 'session' }, { id = 9, role = 'admin' })
  ok(#d.events.rows == 0, 'inside the window the panel\'s handful of XHRs write nothing')
  local a2, d2 = inst(actasdb(target_row()), 10000)
  d2.events.at = 10000 - M.ACT_AS_EVENT_EVERY - 1
  a2:act_as_apply({ act_as = '3', via = 'session' }, { id = 9, role = 'admin' })
  ok(#d2.events.rows == 1, 'past the window the next look is recorded')
end

do -- the token path reaches act_as_apply in order to REFUSE
  local db = actasdb(target_row())
  db.on('FROM api_token k', function()
    return res({}, { { 9, 'google|9', 'a@b.co', 'free', 'admin', 1, 2, 77, 5000 } })
  end)
  local a = inst(db, 5000)
  local acct, s, p = a:resolve_account({ authorization = 'Bearer dfp_live_abcd2345', act_as = '3' })
  ok(acct == nil and s == 403 and code_of(p) == 'act_as_session_required',
     'a token carrying act-as is told no, rather than quietly served as its own owner')
end

-- ================================================== /v1/me and the empty array

local function medb(grants, listed)
  local db = quotadb(grants, 0, 0)
  db.on('FROM account_grant', function()
    return res({ 'id', 'kind', 'quantity', 'detail', 'source', 'offered_at',
                 'redeemed_at', 'expires_at', 'revoked_at', 'spent', 'active' },
               listed or {})
  end)
  return db
end

do
  local a = inst(medb({}, {}))
  local s, body = a:me_body({}, { id = 1, tier = 'free', role = 'user', email = 'a@b.co' })
  ok(s == 200 and type(body) == 'string', '/v1/me answers a hand-assembled string')
  ok(body:sub(-13) == ',"grants":[]}',
     'grants is an ARRAY even when empty: json.encode cannot spell one, and the panel meets [] first')
  ok(body:find('"impersonation"', 1, true) == nil, 'no window, no confession')
  ok(json.decode(body).quota.tier == 'free', 'and the whole thing is still valid JSON')
end

do
  local a = inst(medb({}, { { 5, 'quota_bonus', 3, json.encode({ resource = 'tokens' }), 'thanks',
                             10, nil, nil, nil, 0, 1 } }))
  local _, body = a:me_body({}, { id = 1, tier = 'free' })
  local d = json.decode(body)
  ok(#d.grants == 1 and d.grants[1].kind == 'quota_bonus', 'the list carries the offer')
  ok(d.grants[1].active == true, 'active comes off the SQL fragment, so the card and the cap cannot disagree')
  ok(d.grants[1].detail.resource == 'tokens', 'detail is decoded, not handed over as JSON inside JSON')
  ok(d.grants[1].redeemed_at == nil, 'a missing timestamp is spelled by the key being absent')
end

do
  local a = inst(medb({}, {}))
  local admin = { id = 9, role = 'admin', auth0_sub = 'google|9' }
  local _, body = a:me_body({ impersonating = true, actor = admin },
                            { id = 3, auth0_sub = 'google|3', tier = 'free' })
  local d = json.decode(body)
  ok(d.impersonation.actor == 'google|9' and d.impersonation.actor_role == 'admin',
     'the confession names who is really asking')
  ok(d.impersonation.subject == 'google|3' and d.impersonation.subject_id == 3,
     'and whose account they are wearing, which is all a banner can be built on')
end

-- ================================================ absent, never bound as nil

do
  local db = quotadb({}, 0, 0)
  local a = inst(db, 1000)
  a:grant_insert(4, { kind = 'quota_bonus', quantity = 2, detail = { resource = 'tokens' } }, 'operator', 1000)
  local e = last(db, 'exec', 'INSERT INTO account_grant')
  ok(e.sql:find('expires_at', 1, true) == nil,
     'a nullable column with no value is ABSENT from the statement, never bound as nil')
  ok(e.sql:find('?6', 1, true) ~= nil and e.sql:find('?7', 1, true) == nil,
     'the placeholders are built to match the columns that are there')
  ok(e.binds[4] == json.encode({ resource = 'tokens' }), 'detail is encoded once, on the way in')
  a:grant_insert(4, { kind = 'tier_grant', quantity = 0, detail = {}, expires_at = 2000 }, 'invite:dfi_abcd', 1000)
  local e2 = last(db, 'exec', 'INSERT INTO account_grant')
  ok(e2.sql:find('expires_at', 1, true) ~= nil and e2.binds[7] == 2000,
     'and it joins the statement the moment there is a value')
  ok(e2.sql:find('redeemed_at', 1, true) == nil,
     'the insert writes an OFFER: redeemed_at and revoked_at are simply absent')
end

-- ====================================================== the invite mint loop

do
  local db = mkdb()
  local a = inst(db, 1000)
  local code = a:invite_insert(4, { max_uses = 1, note = '' }, '[]', 1000)
  ok(type(code) == 'string' and code:sub(1, 4) == 'dfi_' and #code == 20,
     'a code is dfi_ plus sixteen base32 symbols')
  local e = last(db, 'try_exec', 'INSERT INTO invite')
  ok(e.sql:find('created_by', 1, true) ~= nil and e.sql:find('expires_at', 1, true) == nil,
     'created_by joins the statement when there is one; an absent expiry stays out')
  ok(count(db, 'try_exec', 'INSERT INTO invite') == 1, 'one draw is enough when the PRIMARY KEY does not refuse')
end

do
  local db = mkdb()
  db.try_result = nil                      -- the PRIMARY KEY refuses every time
  local a = inst(db, 1000)
  local code, why = a:invite_insert(nil, { max_uses = 1, note = '' }, '[]', 1000)
  ok(code == nil and why:find('8 attempts', 1, true) ~= nil, 'eight draws, then an honest refusal')
  ok(count(db, 'try_exec', 'INSERT INTO invite') == M.MINT_ATTEMPTS, 'and exactly eight of them')
  local e = last(db, 'try_exec', 'INSERT INTO invite')
  ok(e.sql:find('created_by', 1, true) == nil,
     'a NULL created_by is not a gap: an operator code is ownerless on purpose, so the column stays out')
end

-- ================================================= accepting one: the button

local function grantdb(row)
  local db = quotadb({}, 0, 0)
  local cols = { 'id', 'account_id', 'kind', 'quantity', 'detail', 'source', 'offered_at',
                 'redeemed_at', 'expires_at', 'revoked_at', 'spent', 'active' }
  db.on('FROM account_grant', function()
    if not row then return res(cols, {}) end
    local r = {}
    for i, k in ipairs(cols) do r[i] = row[k] end
    return res(cols, { r })
  end)
  db.on('FROM account WHERE auth0_sub', function()
    return res({ 'id', 'auth0_sub', 'tier', 'role', 'suspended_at' },
               { { 4, 'google|1', 'free', 'user', nil } })
  end)
  return db
end

do
  local a = inst(as_token(grantdb(nil)))
  local s, p = a:grants_redeem({ authorization = TOKEN }, { grant_id = '1' })
  ok(s == 403 and code_of(p) == 'session_required', 'accepting a gift is something a person does')
  ok(p.error.message == M.GRANT_SESSION, 'and the sentence says so rather than quoting the minting rule')
end

do
  local a = inst(grantdb(nil))
  local req = { sub = 'google|1', impersonating = true, actor = { id = 9 } }
  local s, p = a:grants_redeem(req, { grant_id = '1' })
  ok(s == 403 and code_of(p) == 'act_as_forbidden', 'and never while wearing somebody else\'s face')
end

do
  local db = grantdb(nil)
  local a = inst(db)
  local s, p = a:grants_redeem({ sub = 'google|1' }, { grant_id = '99' })
  ok(s == 404 and code_of(p) == 'not_found', "somebody else's grant id 404s like one that never existed")
  local e = last(db, 'query', 'FROM account_grant')
  ok(e.binds[2] == 4, 'account_id in the WHERE is the authorization, so this is no existence oracle')
  local s2 = a:grants_redeem({ sub = 'google|1' }, { grant_id = 'abc' })
  ok(s2 == 404, 'a non-integer grant id never reaches the database')
end

do
  local a = inst(grantdb({ id = 5, kind = 'quota_bonus', quantity = 2, revoked_at = 900, active = 0 }), 1000)
  local s, p = a:grants_redeem({ sub = 'google|1' }, { grant_id = '5' })
  ok(s == 409 and code_of(p) == 'grant_revoked', '"it was taken back" is its own code')
  local b = inst(grantdb({ id = 5, kind = 'quota_bonus', quantity = 2, expires_at = 1000, active = 0 }), 1000)
  local s2, p2 = b:grants_redeem({ sub = 'google|1' }, { grant_id = '5' })
  ok(s2 == 409 and code_of(p2) == 'grant_expired', '"you were too late" is a different conversation')
end

do
  local db = grantdb({ id = 5, kind = 'quota_bonus', quantity = 2,
                       detail = json.encode({ resource = 'fetchpoints' }), source = 'thanks', active = 1 })
  local a, d = inst(db, 1000)
  local s, p = a:grants_redeem({ sub = 'google|1', real_ip = '9.9.9.9' }, { grant_id = '5' })
  ok(s == 200 and p.grant.id == 5, 'accepting answers the row as it now stands')
  ok(p.quota ~= nil and p.quota.tier == 'free', 'and the new cap travels with it, from the same helper /v1/me reads')
  ok(d.events:kinds() == 'grant.redeem', 'the acceptance is recorded once')
  ok(d.events.rows[1].f.detail.source == 'thanks' and d.events.rows[1].f.detail.kind == 'quota_bonus',
     'the event carries mechanism and provenance, and nothing that names a person')
  local e = last(db, 'exec', 'UPDATE account_grant')
  ok(e.sql:find('redeemed_at IS NULL', 1, true) ~= nil,
     'the UPDATE is what makes it idempotent, not the read above it')

  db.exec_result = { changes = 0 }
  local s2, p2 = a:grants_redeem({ sub = 'google|1' }, { grant_id = '5' })
  ok(s2 == 200 and p2.grant.id == 5, 'a second click is not an error: the grant IS redeemed')
  ok(#d.events.rows == 1, 'and it writes no second event, because changes said who did it')
end

-- ==================================================== confers, at redeem time

do
  local db = quotadb({}, 0, 0)
  local a, d = inst(db, 5000)
  local n = a:apply_confers({ id = 4 }, json.encode({
    { kind = 'quota_bonus', quantity = 5, detail = { resource = 'fetchpoints' } },
    { kind = 'tier_grant', quantity = 0, detail = { tier = 'homelab' }, expires_at = 1 },
    { kind = 'nonsense', quantity = 5 },
    { kind = 'quota_bonus', quantity = 1.5 },
    'not even a table',
  }), 'invite:dfi_abcd', 5000, '1.2.3.4')
  ok(n == 3, 'the shapes it recognises are offered; the rest are skipped rather than refused')
  ok(d.events:kinds() == 'grant.offer,grant.offer,grant.offer',
     'each one lands as grant.offer, exactly as the operator door writes it')
  ok(d.events.rows[1].f.detail.source == 'invite:dfi_abcd',
     'source carries the PREFIX, the one spelling of a code that may travel that road')
  local q = 0
  for _, e in ipairs(db.log) do
    if e.kind == 'exec' and e.sql:find('INSERT INTO account_grant', 1, true) then
      q = q + 1
      if e.sql:find('expires_at', 1, true) then
        ok(e.binds[7] == 1, 'a lapsed tier_grant lands BORN-EXPIRED rather than silently conferring nothing')
      end
    end
  end
  ok(q == 3, 'three offers, three inserts')
  ok(a:apply_confers({ id = 4 }, 'not json', 's', 1, nil) == 0, 'an undecodable confers column offers nothing')
  ok(a:apply_confers({ id = 4 }, json.encode({ { kind = 'quota_bonus', quantity = -3 } }), 's', 1, nil) == 1,
     'a bad quantity is clamped to zero rather than dropping the gift')
end

-- ====================================================== the stranger's door

local function redeemdb(inv, acct)
  local db = quotadb({}, 0, 0)
  local icols = { 'code', 'created_by', 'created_at', 'expires_at', 'max_uses',
                  'used_count', 'revoked_at', 'note', 'confers' }
  db.on('FROM invite WHERE code', function()
    if not inv then return res(icols, {}) end
    local r = {}
    for i, k in ipairs(icols) do r[i] = inv[k] end
    return res(icols, { r })
  end)
  db.on('FROM account WHERE auth0_sub', function()
    if not acct then return res({ 'id' }, {}) end
    return res({ 'id', 'auth0_sub', 'tier', 'role', 'suspended_at' },
               { { acct.id, acct.auth0_sub, acct.tier, acct.role, acct.suspended_at } })
  end)
  return db
end

do
  local a = inst(redeemdb(nil, nil))
  local s, p = a:redeem_post({ sub = 'google|new', act_as = '3' }, {})
  ok(s == 403 and code_of(p) == 'act_as_forbidden',
     'act-as is refused HERE, because resolve_account never runs on this path')
  local s2, p2 = a:redeem_post({ sub = 'google|new', authorization = 'Bearer dfp_live_abcd2345' }, {})
  ok(s2 == 403 and code_of(p2) == 'session_required', 'a token holder is not the stranger this door exists for')
  local s3, p3 = a:redeem_post({}, {})
  ok(s3 == 401 and code_of(p3) == 'unauthenticated', 'and the handler stays correct if it is called from elsewhere')
end

do
  local d = mkdeps(redeemdb(nil, nil), 1000)
  d.rate.deny = true
  local a = M.new(d)
  local s, p, h = a:redeem_post({ sub = 'google|new', real_ip = '1.2.3.4' }, {})
  ok(s == 429 and code_of(p) == 'rate_limited', 'the limiter refusal is returned as data, headers and all')
  ok(h and h['retry-after'] == '7', 'retry-after rides with it')
  ok(d.rate.calls[1].key == 'redeem:1.2.3.4', 'keyed on the EDGE observation, never a header the caller can seed')
  ok(d.rate.calls[1].policy == d.rate.POLICIES.redeem, 'and spent against the limiter library\'s own policy')
  ok(d.rate.calls[1].what:find('too many redemption attempts', 1, true) ~= nil,
     'this library supplies what was spent; the limiter appends the retry sentence')
  local d2 = mkdeps(redeemdb(nil, nil), 1000)
  d2.rate.deny = true
  M.new(d2):redeem_post({ sub = 'google|new' }, {})
  ok(d2.rate.calls[1].key == 'redeem:unknown',
     'callers with no observation share one bucket of the same size: this is the oracle\'s front door')
end

do
  local four = {
    { name = 'a code nobody minted', inv = nil },
    { name = 'a revoked code', inv = { code = 'dfi_abcdefghijklmnop', max_uses = 1, used_count = 0, revoked_at = 5 } },
    { name = 'a lapsed code', inv = { code = 'dfi_abcdefghijklmnop', max_uses = 1, used_count = 0, expires_at = 999 } },
    { name = 'an exhausted code', inv = { code = 'dfi_abcdefghijklmnop', max_uses = 1, used_count = 1 } },
  }
  local bodies = {}
  for _, c in ipairs(four) do
    local a, d = inst(redeemdb(c.inv, nil), 1000)
    local s2, p2 = a:redeem_post({ sub = 'google|new', body = json.encode({ code = 'dfi_abcdefghijklmnop' }) }, {})
    ok(s2 == 404 and p2 == M.INVITE_INVALID, c.name .. ' answers the one refusal')
    bodies[#bodies + 1] = p2.error.message
    ok(#d.events.rows == 0, 'and ' .. c.name .. ' writes nothing')
  end
  ok(bodies[1] == bodies[2] and bodies[2] == bodies[3] and bodies[3] == bodies[4],
     'all four are indistinguishable from outside, so a guesser learns nothing')
end

do
  local inv = { code = 'dfi_abcdefghijklmnop', created_by = 7, max_uses = 3, used_count = 1,
                confers = json.encode({ { kind = 'quota_bonus', quantity = 5 } }) }
  local db = redeemdb(inv, nil)
  local a, d = inst(db, 1000)
  local s, body = a:redeem_post({ sub = 'google|new', body = json.encode({ code = inv.code }),
                                  real_ip = '1.2.3.4' }, {})
  ok(s == 500, 'an account that cannot be read back after the insert is an honest 500')

  local db2 = redeemdb(inv, { id = 12, auth0_sub = 'google|new', tier = 'free', role = 'user' })
  local a2, d2 = inst(db2, 1000)
  local s2, body2 = a2:redeem_post({ sub = 'google|new', body = json.encode({ code = inv.code }),
                                     real_ip = '1.2.3.4' }, {})
  ok(s2 == 200, 'an account holder redeeming a friend\'s code answers 200, not 201')
  ok(body2:sub(-17) == ',"redeemed":true}', 'the redeem marker is spliced onto /v1/me\'s own shape')
  ok(json.decode(body2).quota ~= nil, 'so the page that follows opens on the cards the code conferred')
  ok(d2.events:kinds() == 'grant.offer,invite.redeem',
     'the confers are OFFERED and the advocate gets their receipt; no account.create, because none was created')
  ok(d2.events.rows[2].subject == 7, "the receipt lands on the CODE'S CREATOR, so the advocate sees it work")
  ok(d2.events.rows[2].f.detail.code_prefix == 'dfi_abcd', 'and it carries the prefix, never the code')
  local e = last(db2, 'exec', 'UPDATE invite SET used_count')
  ok(e ~= nil and e.sql:find('used_count + 1', 1, true) ~= nil,
     'the use is spent in ONE statement, so the counter cannot lose an increment')
end

do -- the account being born
  local inv = { code = 'dfi_abcdefghijklmnop', max_uses = 1, used_count = 0, confers = '[]' }
  local made = false
  local db = quotadb({}, 0, 0)
  db.on('FROM invite WHERE code', function()
    return res({ 'code', 'created_by', 'created_at', 'expires_at', 'max_uses', 'used_count',
                 'revoked_at', 'note', 'confers' },
               { { inv.code, nil, 1, nil, 1, 0, nil, nil, '[]' } })
  end)
  db.on('FROM account WHERE auth0_sub', function()
    if not made then return res({ 'id' }, {}) end
    return res({ 'id', 'auth0_sub', 'tier', 'role', 'suspended_at' },
               { { 12, 'google|new', 'free', 'user', nil } })
  end)
  local a, d = inst(db, 1000)
  db.try_result = { changes = 1, rowid = 12 }
  local saved = db.try_exec
  db.try_exec = function(sql, ...)
    local r = saved(sql, ...)
    if sql:find('INSERT INTO account', 1, true) then made = true end
    return r
  end
  local s, body = a:redeem_post({ sub = 'google|new', body = json.encode({ code = inv.code }) }, {})
  ok(s == 201, 'the request that created the account answers 201')
  ok(d.events:kinds() == 'account.create,invite.redeem', 'the birth and the receipt, in that order')
  ok(d.events.rows[1].f.detail.code_prefix == 'dfi_abcd' and d.events.rows[1].f.detail.source == 'invite',
     'account.create names its provenance and never the code')
  ok(d.events.rows[2].subject == 12,
     'an operator code has no creator, so the receipt lands on the new account instead')
end

do -- suspension closes the side door too, and only after the code was read
  local inv = { code = 'dfi_abcdefghijklmnop', max_uses = 1, used_count = 0, confers = '[]' }
  local db = redeemdb(inv, { id = 12, auth0_sub = 'google|s', tier = 'free', role = 'user', suspended_at = 5 })
  local a, d = inst(db, 1000)
  local s, p = a:redeem_post({ sub = 'google|s', body = json.encode({ code = inv.code }) }, {})
  ok(s == 403 and code_of(p) == 'account_suspended', 'a suspended account collects no gifts through the side door')
  ok(p.error.message == M.SUSPENDED, 'and hears the same sentence resolve_account says')
  ok(last(db, 'exec', 'UPDATE invite SET used_count') == nil, 'a refused redemption burns no use')
end

-- ======================================================= the invite handlers

local function inviteacct(db, role, tier)
  db.on('FROM account WHERE auth0_sub', function()
    return res({ 'id', 'auth0_sub', 'tier', 'role', 'suspended_at' },
               { { 4, 'google|1', tier or 'free', role or 'user', nil } })
  end)
  return db
end

do
  local a = inst(inviteacct(quotadb({}, 0, 0)))
  local s, p = a:invites_create({ sub = 'google|1', body = json.encode({ confers = { {} } }) }, {})
  ok(s == 400 and code_of(p) == 'confers_not_here',
     'confers is refused BY NAME: an account holder must not mint a promise this program then breaks')
  local b = inst(as_token(inviteacct(quotadb({}, 0, 0))))
  local s2, p2 = b:invites_create({ authorization = TOKEN }, {})
  ok(s2 == 403 and code_of(p2) == 'session_required', 'minting needs a session')
end

do -- the advocacy dial reads the EFFECTIVE tier
  local db = quotadb({ { 'tier_grant', 0, json.encode({ tier = 'homelab' }) } }, 0, 0)
  inviteacct(db)
  db.on('COUNT(*) FROM invite', function() return res({ 'c' }, { { 4 } }) end)
  db.on('FROM invite WHERE code', function()
    return res({ 'code', 'created_by', 'created_at', 'expires_at', 'max_uses', 'used_count',
                 'revoked_at', 'note', 'confers' },
               { { 'dfi_abcdefghijklmnop', 4, 1000, nil, 1, 0, nil, '', '[]' } })
  end)
  local a = inst(db, 1000)
  local s = a:invites_create({ sub = 'google|1' }, {})
  ok(s == 201, "a tester on a granted Homelab gets Homelab's ten invites, not free's two")
  local db2 = quotadb({}, 0, 0)
  inviteacct(db2)
  db2.on('COUNT(*) FROM invite', function() return res({ 'c' }, { { 2 } }) end)
  local a2, d2 = inst(db2, 1000)
  local s2, p2 = a2:invites_create({ sub = 'google|1' }, {})
  ok(s2 == 403 and code_of(p2) == 'quota_exceeded', 'and free stops at two live codes')
  ok(p2.error.message:find('2 live invite codes', 1, true) ~= nil, 'the refusal says the number and the plural')
  ok(#d2.events.rows == 0, 'a refused mint records nothing')
end

do
  local db = quotadb({}, 0, 0)
  inviteacct(db)
  db.on('COUNT(*) FROM invite', function() return res({ 'c' }, { { 0 } }) end)
  db.on('FROM invite WHERE code', function()
    return res({ 'code', 'created_by', 'created_at', 'expires_at', 'max_uses', 'used_count',
                 'revoked_at', 'note', 'confers' },
               { { 'dfi_abcdefghijklmnop', 4, 1000, nil, 1, 0, nil, 'for jane', '[]' } })
  end)
  local a, d = inst(db, 1000)
  local s, body = a:invites_create({ sub = 'google|1', real_ip = '1.2.3.4' }, {})
  ok(s == 201 and body:find('"confers":[]', 1, true) ~= nil,
     'confers is an ARRAY even when empty, which is the shape the panel meets first')
  ok(json.decode(body).invite.uses_remaining == 1, 'and uses_remaining is arithmetic the panel does not repeat')
  ok(d.events:kinds() == 'invite.create', 'the mint is recorded')
  local ins = last(db, 'try_exec', 'INSERT INTO invite')
  ok(d.events.rows[1].f.detail.code_prefix == M.invite_prefix(ins.binds[1])
     and #d.events.rows[1].f.detail.code_prefix == 8
     and d.events.rows[1].f.detail.code_prefix ~= ins.binds[1],
     'the event carries the PREFIX of the code that was actually drawn, never the code')
  ok(d.events.rows[1].f.detail.note == nil,
     'and never the note, which is where people write an address')
end

do -- revoking
  local icols = { 'code', 'created_by', 'created_at', 'expires_at', 'max_uses', 'used_count',
                  'revoked_at', 'note', 'confers' }
  local db = quotadb({}, 0, 0)
  inviteacct(db)
  db.on('FROM invite WHERE code', function(code, owner)
    return res(icols, { { 'dfi_abcdefghijklmnop', 7, 1, nil, 3, 3, nil, '', '[]' } })
  end)
  local a, d = inst(db, 1000)
  local s, p = a:invites_delete({ sub = 'google|1' }, { code = 'dfi_abcdefghijklmnop' })
  ok(s == 200 and p.revoked == true, 'a code with every use spent still revokes')
  ok(d.events.rows[1].subject == 7,
     "the subject is the code's creator, so an admin revoking a customer's code lands on the customer's timeline")
  local e = last(db, 'query', 'FROM invite WHERE code')
  ok(e.binds[2] == 4, 'created_by in the WHERE is the authorization for everyone but an admin')

  local db2 = quotadb({}, 0, 0)
  inviteacct(db2, 'admin')
  db2.on('FROM invite WHERE code', function() return res(icols, { { 'dfi_x', 7, 1, nil, 1, 0, nil, '', '[]' } }) end)
  local a2 = inst(db2, 1000)
  a2:invites_delete({ sub = 'google|1' }, { code = 'dfi_x' })
  ok(last(db2, 'query', 'FROM invite WHERE code').binds[2] == nil, 'an admin revokes anyone\'s, as themselves')

  local db3 = quotadb({}, 0, 0)
  inviteacct(db3)
  db3.on('FROM invite WHERE code', function() return res(icols, { { 'dfi_x', 4, 1, nil, 1, 0, 99, '', '[]' } }) end)
  local a3 = inst(db3, 1000)
  local s3, p3 = a3:invites_delete({ sub = 'google|1' }, { code = 'dfi_x' })
  ok(s3 == 404 and code_of(p3) == 'not_found', 'an already-revoked code 404s: the revocation does not exist to perform')
end

-- =========================================================== the token routes

do
  local db = quotadb({}, 0, 1)     -- free holds one, and one is used
  inviteacct(db)
  local a = inst(db, 1000)
  local s, p = a:tokens_create({ sub = 'google|1' }, {})
  ok(s == 403 and code_of(p) == 'quota_exceeded', 'the cap is counted over live rows, through quota_of')
  ok(p.error.message:find('1 API token ', 1, true) ~= nil, 'and the message gets the singular right')
end

do
  local db = quotadb({ { 'quota_bonus', 2, json.encode({ resource = 'tokens' }) } }, 0, 1)
  inviteacct(db)
  local a, d = inst(db, 1000)
  local s, p = a:tokens_create({ sub = 'google|1', real_ip = '1.2.3.4' }, {})
  ok(s == 201, 'a redeemed bonus adds to the cap the create gate reads, not just the one the panel shows')
  ok(p.token.secret:sub(1, 9) == 'dfp_live_' and #p.token.secret == 9 + 32,
     'the secret is the prefix plus thirty-two symbols')
  ok(p.token.prefix == p.token.secret:sub(1, 13),
     'the stored prefix carries four symbols of the BODY, so it says WHICH token')
  ok(p.warning:find('only time', 1, true) ~= nil, 'and it is shown exactly once')
  local e = last(db, 'exec', 'INSERT INTO api_token')
  ok(e.binds[4] == 'H:' .. p.token.secret, 'the hash is stored, never the secret')
  ok(d.events.rows[1].f.detail.prefix == p.token.prefix and d.events.rows[1].f.detail.name == '',
     'the timeline gets the prefix, never the secret')
end

do
  local db = quotadb({}, 0, 0)
  inviteacct(db)
  local a = inst(db, 1000)
  local s, p = a:tokens_create({ sub = 'google|1', impersonating = true, actor = { id = 9 } }, {})
  ok(s == 403 and code_of(p) == 'act_as_forbidden', 'a window that can cut its own key is a key')
  local s2, p2 = a:tokens_delete({ sub = 'google|1', impersonating = true, actor = { id = 9 } },
                                 { token_id = '1' })
  ok(s2 == 403 and code_of(p2) == 'act_as_forbidden', 'and revoking is minting run backwards')
  local s3, p3 = a:tokens_create({ sub = 'google|1', body = json.encode({ name = string.rep('x', 121) }) }, {})
  ok(s3 == 400 and code_of(p3) == 'invalid_name', 'a name is optional, and bounded when given')
end

do
  local db = quotadb({}, 0, 0)
  inviteacct(db)
  db.exec_result = { changes = 0 }
  local a = inst(db, 1000)
  local s, p = a:tokens_delete({ sub = 'google|1' }, { token_id = '404' })
  ok(s == 404 and code_of(p) == 'not_found',
     "another account's token id matches nothing and 404s like one that never existed")
  local s2 = a:tokens_delete({ sub = 'google|1' }, { token_id = 'abc' })
  ok(s2 == 404, 'a non-numeric token id never reaches the database')
end

do
  local db = quotadb({}, 0, 0)
  inviteacct(db)
  table.insert(db.routes, 1, { pat = 'SELECT id, name, prefix',
                               fn = function() return res({ 'id', 'name' }, {}) end })
  local a = inst(db, 1000)
  local s, body = a:tokens_list({ sub = 'google|1' }, {})
  ok(s == 200 and body == '{"tokens":[]}', 'an empty token list is an ARRAY, spelled as text')
end

-- ============================================================ me_patch

do
  local db = quotadb({}, 0, 0)
  db.on('FROM account WHERE auth0_sub', function()
    return res({ 'id', 'auth0_sub', 'email', 'tier', 'role', 'suspended_at' },
               { { 4, 'google|1', 'old@b.co', 'free', 'user', nil } })
  end)
  db.on('FROM account_grant', function() return res({ 'id' }, {}) end)
  local a, d = inst(db, 1000)
  local s, p = a:me_patch({ sub = 'google|1', body = json.encode({ emial = 'x@y.co' }) }, {})
  ok(s == 400 and code_of(p) == 'immutable_field', 'an unknown key is refused BY NAME, never dropped on the floor')
  local s2, p2 = a:me_patch({ sub = 'google|1', body = '{}' }, {})
  ok(s2 == 400 and code_of(p2) == 'nothing_to_change', 'and an empty body is not "clear it"')
  local s3, p3 = a:me_patch({ sub = 'google|1', body = json.encode({ email = 'nope' }) }, {})
  ok(s3 == 400 and code_of(p3) == 'invalid_email', 'the address is checked by the waitlist\'s own loose rule')
  local s4 = a:me_patch({ sub = 'google|1', body = json.encode({ email = 'old@b.co' }) }, {})
  ok(s4 == 200 and #d.events.rows == 0, 'a PATCH that moved the column nowhere is silence')
  a:me_patch({ sub = 'google|1', body = json.encode({ email = ' NEW@B.CO ' }) }, {})
  ok(d.events:kinds() == 'account.email.set', 'setting one is an event of its own kind')
  local e = last(db, 'exec', 'UPDATE account SET email = ?1')
  ok(e.binds[1] == 'new@b.co', 'trimmed and lowered on the way in')
  a:me_patch({ sub = 'google|1', body = json.encode({ email = '' }) }, {})
  ok(d.events:kinds() == 'account.email.set,account.email.clear', 'and clearing one is another')
  ok(last(db, 'exec', 'email = NULL') ~= nil,
     'clearing gets its own statement, because the connector refuses a nil bind')
  local s5, p5 = a:me_patch({ sub = 'google|1', impersonating = true, actor = { id = 9 },
                              body = json.encode({ email = 'x@y.co' }) }, {})
  ok(s5 == 403 and code_of(p5) == 'act_as_forbidden', 'and never while wearing somebody else\'s face')
end

-- ========================================================== the rank ladder

do
  local function rankdb(role)
    local db = quotadb({}, 0, 0)
    inviteacct(db, role)
    return db
  end
  local a = inst(rankdb('user'))
  local acct, s, p = a:require_role({ sub = 'google|1' }, 'audit')
  ok(acct == nil and s == 403 and code_of(p) == 'audit_required', 'a customer is not an auditor')
  local a2 = inst(rankdb('audit'))
  ok(a2:require_role({ sub = 'google|1' }, 'audit') ~= nil, 'an auditor reads the read-only views')
  ok(select(3, a2:require_admin({ sub = 'google|1' })) .error.code == 'admin_required',
     "'admin_required' is load-bearing: the panel and the battery match on it by name")
  local a3 = inst(rankdb('admin'))
  ok(a3:require_admin({ sub = 'google|1' }) ~= nil, 'an admin is at least an admin')
  ok(a3:require_role({ sub = 'google|1' }, 'audit') ~= nil, 'and reads everything below it, because the ladder is ranked')
  local a4 = inst(as_token(rankdb('admin'), 'admin'))
  local acct4, s4, p4 = a4:require_person({ authorization = TOKEN }, 'admin')
  ok(acct4 == nil and s4 == 403 and code_of(p4) == 'session_required',
     'a token may read a machine view; personal data demands a session')
  ok(p4.error.message:find('machine views', 1, true) ~= nil, 'and the sentence says which views a token does read')
  ok(a4:require_person({ sub = 'google|1' }, 'admin') ~= nil, 'a signed-in admin passes both halves')
end

print(fails == 0 and "PASS" or ("FAIL " .. fails))
